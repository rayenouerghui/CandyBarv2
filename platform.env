# Optional overrides for ./run — uncomment and edit to override the
# default Pi Zero 2 W rendering config (QT_QUICK_BACKEND=software,
# QT_QPA_PLATFORM=linuxfb) without touching run or main.py.
#
# Video requires eglfs+GPU compositing for smooth playback, which is why
# this differs from the earlier linuxfb+software config used before video
# was restored. The unset QT_QUICK_BACKEND allows Qt to choose the optimal
# backend (typically OpenGL) for video rendering.
QT_QPA_PLATFORM=eglfs
QT_QUICK_BACKEND=
