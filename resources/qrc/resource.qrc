<RCC>
    <qresource prefix="/">
        <!-- Root QML -->
        <file alias="app/qml/App.qml">../../ui/App.qml</file>
        <file alias="app/qml/MainDisplay.qml">../../ui/MainDisplay.qml</file>
        <file alias="app/qml/DisplayView.qml">../../ui/DisplayView.qml</file>
        <file alias="app/qml/BackgroundDisplay.qml">../../ui/BackgroundDisplay.qml</file>
        <file alias="app/qml/LogoComponent.qml">../../ui/LogoComponent.qml</file>
        <file alias="app/qml/CategoryBadge.qml">../../ui/CategoryBadge.qml</file>
        <file alias="app/qml/NowServingLabel.qml">../../ui/NowServingLabel.qml</file>
        <file alias="app/qml/ServingNumber.qml">../../ui/ServingNumber.qml</file>
        <file alias="app/qml/AccentUnderline.qml">../../ui/AccentUnderline.qml</file>
        <file alias="app/qml/WelcomeSplash.qml">../../ui/WelcomeSplash.qml</file>
        <file alias="app/qml/ConnectionBanner.qml">../../ui/ConnectionBanner.qml</file>
        <file alias="app/qml/CustomerSiteQrOverlay.qml">../../ui/CustomerSiteQrOverlay.qml</file>

        <!-- Global singleton -->
        <file alias="app/qml/global/DisplayState.qml">../../ui/global/DisplayState.qml</file>
        <file alias="app/qml/global/qmldir">../../ui/global/qmldir</file>

        <!-- Assets -->
        <file alias="app/res/image/genical.jpg">../../resources/logos/genical.jpg</file>
        <file alias="app/res/image/favicon.ico">../../resources/icons/favicon.ico</file>
        <file alias="app/res/image/noise_texture.png">../../resources/backgrounds/noise_texture.png</file>
        <file alias="app/res/image/0.jpg">../../resources/backgrounds/0.jpg</file>

        <!-- Backgrounds — Professional -->
        <file alias="app/res/image/pro_abstract.jpg">../../resources/backgrounds/pro_abstract.jpg</file>
        <file alias="app/res/image/pro_geometric.jpg">../../resources/backgrounds/pro_geometric.jpg</file>

        <!-- Backgrounds — Fast Food -->
        <file alias="app/res/image/ff_red_waves.jpg">../../resources/backgrounds/ff_red_waves.jpg</file>
        <file alias="app/res/image/ff_burger_pattern.jpg">../../resources/backgrounds/ff_burger_pattern.jpg</file>

        <!-- Fonts: Custom display fonts -->
        <file alias="app/res/font/Barriecito-Regular.ttf">../../resources/fonts/Barriecito-Regular.ttf</file>
        <file alias="app/res/font/DTGetaiGroteskDisplay-Black.otf">../../resources/fonts/DTGetaiGroteskDisplay-Black.otf</file>
        <file alias="app/res/font/Gluten-Regular.ttf">../../resources/fonts/Gluten-Regular.ttf</file>
        <file alias="app/res/font/LCMogi-A.otf">../../resources/fonts/LCMogi-A.otf</file>
        <file alias="app/res/font/Manosque-Regular.otf">../../resources/fonts/Manosque-Regular.otf</file>
    </qresource>
</RCC>
