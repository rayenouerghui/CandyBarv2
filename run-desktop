#!/bin/bash
# Desktop GUI mode runner for local testing
# This script temporarily enables desktop GUI mode by creating a temporary platform.env override

# Save original platform.env if it exists
PLATFORM_ENV_ORIG=""
if [ -f ./platform.env ]; then
    PLATFORM_ENV_ORIG=$(cat ./platform.env)
fi

# Restore function - always runs on exit
restore_platform_env() {
    if [ -z "$PLATFORM_ENV_ORIG" ]; then
        rm -f ./platform.env
    else
        echo "$PLATFORM_ENV_ORIG" > ./platform.env
    fi
}

cleanup_and_exit() {
    [ -n "$CHILD_PID" ] && kill -TERM "$CHILD_PID" 2>/dev/null
}

trap cleanup_and_exit INT TERM
trap restore_platform_env EXIT

# Create temporary platform.env for desktop GUI mode
cat > ./platform.env << 'EOF'
# TEMPORARY DESKTOP GUI TESTING (auto-generated by run-desktop)
QT_QPA_PLATFORM=xcb
QT_QUICK_BACKEND=
EOF

# Unset any headless mode
unset CANDYBAR_HEADLESS

# Skip port conflict check for desktop testing (allows multiple instances)
export SKIP_PORT_CHECK=1

echo "=== Desktop GUI Mode ==="
echo "QT_QPA_PLATFORM=xcb (via temporary platform.env)"
echo "QT_QUICK_BACKEND= (via temporary platform.env)"
echo "CANDYBAR_HEADLESS=${CANDYBAR_HEADLESS:-unset}"
echo ""
echo "Starting app in desktop GUI mode..."
echo "Press Ctrl+C to stop"
echo ""

# Run the main script in background and track PID
./run "$@" &
CHILD_PID=$!
wait "$CHILD_PID"
